<?xml version="1.0" encoding="UTF-8"?>
<!-- The form compiler's golden document (stage FD, phases FD5 and FD-6): a
   form root with the window's title, client size and buttons; nested
   controls; a component; bindings of Values (two way by the property's
   default, and narrowed to one way) and of Commands; values of several
   kinds (text items among them), and a title outside ASCII. -->
<form xmlns="urn:gui-forms:form:1" id="sample.dialog"
    text="Réglages"
    client-size="480 320"
    accept-button="sample.ok"
    cancel-button="sample.cancel">

  <user-control id="sample.root"
      padding="4 8">
    <group-box id="sample.general"
        tab-index="0">
      <check-box id="sample.general.auto-save"
          text="Save automatically"
          tab-index="0">
        <bind property="checked" to="auto_save_"/>
      </check-box>
    </group-box>
    <button id="sample.ok" text="OK" tab-index="1" anchor="top right">
      <bind property="command" to="accept_"/>
    </button>
    <button id="sample.cancel" text="Cancel" tab-index="2">
      <bind property="command" to="dismiss_"/>
    </button>
    <list-box id="sample.modes" items="AM FM 'Wide FM'" tab-index="3"/>
    <domain-up-down id="sample.band" items="HF VHF UHF" tab-index="4"/>
    <label id="sample.heading" text="Bands"/>
    <numeric-up-down id="sample.level" tab-index="5">
      <bind property="value" to="level_" mode="one-way"/>
    </numeric-up-down>
  </user-control>
  <command id="sample.save"/>
</form>
