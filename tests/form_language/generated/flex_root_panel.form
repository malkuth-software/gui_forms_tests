<?xml version="1.0" encoding="UTF-8"?>
<!-- A control root whose type is final (stage B): FlexPanel admits no
   subclass, so the build composes FlexRootPanel, which holds the panel as
   its member flex_root, with gui_forms_add_form MODEL. -->
<flex-panel xmlns="urn:gui-forms:form:1" id="flex.root"
    padding="2"
    auto-scroll="true">
  <check-box id="flex.flag" text="Flag" tab-index="0">
    <bind property="checked" to="auto_save_"/>
  </check-box>
  <button id="flex.go" text="Go" tab-index="1">
    <bind property="command" to="accept_"/>
  </button>
</flex-panel>
