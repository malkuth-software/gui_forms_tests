<?xml version="1.0" encoding="UTF-8"?>
<!-- A settings dialog: properties, bindings, tab order and the
   classes its project theme styles (a form holds no style blocks). -->
<form xmlns="urn:gui-forms:form:1" id="settings.dialog"
    text="Settings"
    size="480 320"
    accept-button="settings.ok"
    cancel-button="settings.cancel">

  <group id="settings.general"
      text="General"
      tab-index="0">
    <check-box id="settings.general.autosave"
        text="Save automatically"
        tab-index="0">
      <bind property="checked" to="autosave_"/>
    </check-box>
    <text-box id="settings.general.name"
        tab-index="1"
        classes="'field wide'">
      <bind property="text" to="settings_" field="name" update="on-change"/>
    </text-box>
  </group>

  <button id="settings.ok"
      text="OK"
      tab-index="1"
      classes="default-action">
    <bind property="command" to="accept_"/>
  </button>
  <button id="settings.cancel" text="Cancel" tab-index="2">
    <bind property="command" to="dismiss_"/>
  </button>
</form>
